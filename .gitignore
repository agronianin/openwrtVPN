# Publish code and clean defaults only. Personal recovery data stays local.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/install.sh
!/defaults/
!/docs/
/docs/local-setup.md
!/tests/
!/router-reinstall-kit/
/router-reinstall-kit/*
!/router-reinstall-kit/files/
/router-reinstall-kit/files/*
!/router-reinstall-kit/files/usr/
!/router-reinstall-kit/files/etc/
!/router-reinstall-kit/files/opt/
/router-reinstall-kit/files/etc/*
!/router-reinstall-kit/files/etc/init.d/
/router-reinstall-kit/files/etc/init.d/*
!/router-reinstall-kit/files/etc/init.d/sing-box
!/router-reinstall-kit/files/etc/init.d/router-control-web
!/router-reinstall-kit/files/etc/init.d/modem-t77w968-qmi
!/router-reinstall-kit/files/etc/sing-box/
/router-reinstall-kit/files/etc/sing-box/*
!/router-reinstall-kit/files/etc/sing-box/rule-packs/
/router-reinstall-kit/files/etc/sing-box/rule-packs/*
!/router-reinstall-kit/files/etc/sing-box/rule-packs/apply-rules
!/router-reinstall-kit/files/etc/sing-box/rule-packs/RULES-FORMAT.md
/router-reinstall-kit/files/opt/*
!/router-reinstall-kit/files/opt/router-control/
.DS_Store
/router-reinstall-kit/files/usr/bin/modem-qmi-connect
/router-reinstall-kit/files/usr/bin/modem-qmi-retry
*.previous
*.log
