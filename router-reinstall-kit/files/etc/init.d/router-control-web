#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

ROOT="/opt/router-control/www"

start_service() {
  [ -x /usr/sbin/uhttpd ] || return 1
  [ -d "$ROOT" ] || return 1
  lan="$(uci -q get openwrtvpn.main.lan_interface || echo lan)"
  BIND_ADDR="$(ubus call "network.interface.$lan" status | jsonfilter -e '@["ipv4-address"][0].address')"
  [ -n "$BIND_ADDR" ] || return 1
  PORT="$(uci -q get openwrtvpn.main.web_port || echo 8090)"
  case "$PORT" in ''|*[!0-9]*) return 1 ;; esac
  [ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || return 1
  auth=/dev/null
  if [ "$(uci -q get openwrtvpn.main.web_auth || echo 0)" = 1 ]; then
    auth=/opt/router-control/httpd.conf
    [ -s "$auth" ] || return 1
  fi

  procd_open_instance
  procd_set_param command /usr/sbin/uhttpd -f -c "$auth" -D -S -h "$ROOT" -r OpenWrtVPN -x /cgi-bin -t 60 -T 30 -A 1 -n 3 -N 20 -p "$BIND_ADDR:$PORT"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

service_triggers() {
  procd_add_reload_trigger openwrtvpn network
  procd_add_interface_trigger 'interface.*' "$(uci -q get openwrtvpn.main.lan_interface || echo lan)" /etc/init.d/router-control-web restart
}
