#!/bin/sh /etc/rc.common

START=25
STOP=05
USE_PROCD=1

start_service() {
  [ "$(uci -q get openwrtvpn.main.modem_enabled || echo 0)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/modem-t77w968 boot
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}
