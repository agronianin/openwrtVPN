<script>
(function () {
  function resultTarget(form) {
    var target = form.querySelector('.inline-result');
    if (target) return target;
    var tab = new FormData(form).get('tab') || 'overview';
    return document.getElementById(tab + '-result');
  }

  function requestUrl(form) {
    return form.getAttribute('action') || window.location.pathname;
  }

  document.addEventListener('submit', function (event) {
    var form = event.target;
    if (!form.matches('form')) return;
    var target = resultTarget(form);
    if (!target || !window.fetch || !window.FormData) return;

    event.preventDefault();
    var data = new FormData(form);
    data.set('ajax', '1');
    var controls = Array.from(form.elements).map(function (element) { return { element: element, disabled: element.disabled }; });
    controls.forEach(function (entry) { entry.element.disabled = true; });
    target.innerHTML = '<section class="result"><strong>Выполняется...</strong></section>';

    fetch(requestUrl(form), {
      method: 'POST',
      body: new URLSearchParams(data),
      credentials: 'same-origin'
    }).then(function (response) {
      return response.text().then(function (html) {
        if (!response.ok) throw new Error('HTTP ' + response.status + ': ' + html.slice(0, 200));
        return html;
      });
    }).then(function (html) {
      target.innerHTML = html;
      var saved = target.querySelector('[data-saved-revision]');
      if (saved) {
        form.querySelector('[name=revision]').value = saved.dataset.savedRevision;
        form.dispatchEvent(new Event('subscription-saved'));
      }
      if (!target.querySelector('.result.bad') && form.closest('.tab-vpn')) {
        fetch(requestUrl(form), { method: 'POST', body: 'action=vpn_snapshot&tab=vpn',
          headers: {'Content-Type':'application/x-www-form-urlencoded'}, credentials:'same-origin'
        }).then(function (response) { return response.text(); }).then(function (summary) {
          var panel = document.getElementById('vpn-summary');
          if (panel) panel.innerHTML = summary;
        }).catch(function () {});
      }
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }).catch(function (error) {
      target.innerHTML = '<section class="result bad"><strong>Ошибка AJAX</strong><pre>' +
        String(error).replace(/[&<>]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c]; }) +
        '</pre></section>';
    }).finally(function () {
      controls.forEach(function (entry) { entry.element.disabled = entry.disabled; });
    });
  });
}());
</script>
</body>
</html>
EOF
