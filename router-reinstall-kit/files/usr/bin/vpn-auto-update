#!/bin/sh
set -eu

SETTINGS_FILE="/etc/sing-box/vpn-config/vpn-settings.conf"
STATE_FILE="/etc/sing-box/subscriptions-cache/last-auto-update"
UPDATE_INTERVAL_HOURS=6

[ -f "$SETTINGS_FILE" ] && . "$SETTINGS_FILE"

save_attempt() {
  mkdir -p "$(dirname "$STATE_FILE")"
  printf '%s\n' "$1" > "$STATE_FILE.new.$$"
  mv "$STATE_FILE.new.$$" "$STATE_FILE"
}

if [ -s /etc/sing-box/profiles/update-request ] && /etc/init.d/sing-box status >/dev/null 2>&1; then
  requested=$(cat /etc/sing-box/profiles/update-request)
  rc=0
  /usr/bin/vpn-profiles update-queued || rc=$?
  if [ "$requested" = all ] && [ "$rc" != 75 ]; then save_attempt "$(date +%s)"; fi
  exit "$rc"
fi

case "$UPDATE_INTERVAL_HOURS" in
  *[!0-9]*) echo 'ERROR: invalid UPDATE_INTERVAL_HOURS' >&2; exit 2 ;;
  ''|0)
    exit 0
    ;;
esac

if ! /etc/init.d/sing-box status >/dev/null 2>&1; then
  logger -t vpn-auto-update "VPN is off; automatic subscription update skipped"
  exit 0
fi

now="$(date +%s)"
last=0
[ -s "$STATE_FILE" ] && last="$(sed -n '1p' "$STATE_FILE")"
case "$last" in
  *[!0-9]*|'') last=0 ;;
esac

interval_seconds=$((UPDATE_INTERVAL_HOURS * 3600))
age=$((now - last))

if [ "$age" -lt "$interval_seconds" ]; then
  exit 0
fi

updater=/usr/bin/vpn-subscriptions-update
[ ! -f /etc/sing-box/profiles/catalog.json ] || updater=/usr/bin/vpn-profiles
action=refresh
[ "$updater" != /usr/bin/vpn-profiles ] || action=update
rc=0
"$updater" "$action" || rc=$?
# A partial failure must not turn the configured hourly schedule into a once-per-minute retry loop.
[ "$rc" = 75 ] || save_attempt "$(date +%s)"
if [ "$rc" = 0 ]; then
  logger -t vpn-auto-update "subscription cache refresh completed without applying config"
else
  logger -t vpn-auto-update "subscription cache refresh failed"
  exit 1
fi
